<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/agent_widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/agent_widget_badge"
            android:gravity="center"
            android:minWidth="24dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:textColor="@color/agent_widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agent_widget_title"
            android:textColor="@color/agent_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ring_5h_label"
            style="@style/AgentWidgetRingLabel"
            android:text="@string/agent_widget_limit_5h"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/widget_ring_5h"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone">
            <ProgressBar
                android:id="@+id/widget_ring_5h_normal"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/agent_widget_ring_normal"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ProgressBar
                android:id="@+id/widget_ring_5h_warning"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/agent_widget_ring_warning"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ProgressBar
                android:id="@+id/widget_ring_5h_critical"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/agent_widget_ring_critical"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/widget_ring_5h_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/agent_widget_on_surface"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_ring_7d_label"
            style="@style/AgentWidgetRingLabel"
            android:text="@string/agent_widget_limit_7d"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/widget_ring_7d"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone">
            <ProgressBar
                android:id="@+id/widget_ring_7d_normal"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/agent_widget_ring_normal"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ProgressBar
                android:id="@+id/widget_ring_7d_warning"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/agent_widget_ring_warning"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ProgressBar
                android:id="@+id/widget_ring_7d_critical"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/agent_widget_ring_critical"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/widget_ring_7d_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/agent_widget_on_surface"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/agent_widget_empty"
        android:textColor="@color/agent_widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_agent_1"
        style="@style/AgentWidgetRow"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/widget_agent_2"
        style="@style/AgentWidgetRow" />

    <TextView
        android:id="@+id/widget_agent_3"
        style="@style/AgentWidgetRow" />

    <TextView
        android:id="@+id/widget_agent_4"
        style="@style/AgentWidgetRow" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/agent_widget_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
